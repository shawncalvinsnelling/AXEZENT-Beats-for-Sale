# AXEZENT self-hosted HTTPS configuration.
# Replace beats.example.com with the actual domain whose DNS points at your server.
# Run server/axezent_site.py on 127.0.0.1:8080 using a non-root account.
# Make sure private tagged previews live OUTSIDE this GitHub repository.
# Caddy is installed on the owner-controlled server, not a website-builder platform.
beats.example.com {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8080
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
